{
  "uid": "boutique-slo",
  "title": "Boutique — SLO и бюджет ошибок",
  "tags": ["slo", "boutique", "gitops-slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Доступность, 30 дней (SLO 99.5%)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "1 - slo:sli_error:ratio_rate30d{slo=\"availability\"}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Остаток бюджета ошибок: доступность",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "slo:error_budget_remaining:ratio{slo=\"availability\"}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 оформления заказа (5 мин)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "boutique:checkout_latency_seconds:p95_5m" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Остаток бюджета: checkout < 1 с (SLO 95%)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "slo:error_budget_remaining:ratio{slo=\"checkout-latency\"}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 }] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Burn rate доступности (1 = расход ровно по бюджету)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "slo:sli_error:ratio_rate5m{slo=\"availability\"} / 0.005", "legendFormat": "5m" },
        { "refId": "B", "expr": "slo:sli_error:ratio_rate1h{slo=\"availability\"} / 0.005", "legendFormat": "1h" },
        { "refId": "C", "expr": "slo:sli_error:ratio_rate6h{slo=\"availability\"} / 0.005", "legendFormat": "6h" }
      ],
      "fieldConfig": { "defaults": { "unit": "x",
        "custom": { "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Запросы через prod Gateway по классу ответа",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_xx{gateway=\"prod\"}[1m]))", "legendFormat": "{{envoy_response_code_class}}xx" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Оформление заказа: задержка (Envoy, upstream)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{gateway=\"prod\", envoy_cluster_name=\"httproute/boutique-prod/frontend/rule/0\"}[5m]))) / 1000", "legendFormat": "p50" },
        { "refId": "B", "expr": "boutique:checkout_latency_seconds:p95_5m", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{gateway=\"prod\", envoy_cluster_name=\"httproute/boutique-prod/frontend/rule/0\"}[5m]))) / 1000", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Kafka: отставание consumer-групп",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic=~\"orders.*\"})", "legendFormat": "{{consumergroup}} / {{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "short",
        "custom": { "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Обработанные события заказов (prod)",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(orders_processed_total{namespace=\"boutique-prod\"}[1m]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 10, "type": "logs", "title": "Ошибки и предупреждения prod (Loki)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"boutique-prod\", level=~\"error|warning|warn\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
